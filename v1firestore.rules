rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function hasCourseAccess(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.courseIds is list
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.courseIds.hasAny([courseId]);
    }

    match /admins/{uid} {
      // Cada administrador solo puede consultar su propio documento.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /students/{uid} {
      // Cada estudiante solo puede consultar su propio documento de autorización.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /courses/{courseId} {
      // La lectura exige administrador activo o estudiante activo con acceso al curso.
      allow get: if isAdmin() || hasCourseAccess(courseId);
      allow list, create, update, delete: if false;

      match /weeks/{weekId} {
        allow get: if isAdmin() || hasCourseAccess(courseId);
        allow list, create, update, delete: if false;
      }
    }
  }
}
