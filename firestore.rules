rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function activeStudentInCourse(uid, courseId) {
      return exists(/databases/$(database)/documents/students/$(uid))
        && get(/databases/$(database)/documents/students/$(uid)).data.active == true
        && get(/databases/$(database)/documents/students/$(uid)).data.courseIds is list
        && get(/databases/$(database)/documents/students/$(uid)).data.courseIds.hasAny([courseId]);
    }

    function hasCourseAccess(courseId) {
      return signedIn() && activeStudentInCourse(request.auth.uid, courseId);
    }

    match /admins/{uid} {
      // Cada administrador solo puede consultar su propio documento.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /students/{uid} {
      // Cada estudiante solo puede consultar su propio documento de autorización.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if false;

      match /logins/{loginId} {
        allow get, list: if isAdmin();
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['uid', 'courseId', 'at'])
          && request.resource.data.keys().hasOnly(['uid', 'courseId', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.courseId is string
          && request.resource.data.courseId.size() > 0
          && activeStudentInCourse(uid, request.resource.data.courseId)
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    match /courses/{courseId} {
      // La lectura exige administrador activo o estudiante activo con acceso al curso.
      allow get: if isAdmin() || hasCourseAccess(courseId);
      allow list, create, update, delete: if false;

      match /weeks/{weekId} {
        allow get: if isAdmin() || hasCourseAccess(courseId);
        allow list, create, update, delete: if false;
      }
    }
  }
}
